# Art factory: names only, never values (Key Keeper). Real values go in .env
# on your machine and in Vercel → Project → Settings → Environment Variables.

# Who the admin is (skip if the project has its own accounts and isAdmin)
ADMIN_PASSWORD=
# Optional: signs the admin cookie; without it the password is used
ADMIN_SESSION_SECRET=

# A picture maker: one or both. Without either, the factory offers Practice only.
OPENAI_API_KEY_ImageGen=
GOOGLE_API_KEY_ImageGen=
# Optional model overrides (the switcher picks OpenAI's model and quality)
# ART_OPENAI_MODEL=
# ART_GOOGLE_MODEL=

# Memory: Upstash Redis (Vercel → Storage → Upstash adds these two for you)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Pictures: Cloudflare R2, one private bucket
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: Make art pictures per person per day before the admin changes it (default 5)
# ART_DAILY_CAP=
